{
  "plugins": [
    {
      "name": "Lorax",
      "url": "http://localhost:9000/dist/jbrowse-plugin-lorax.umd.development.js"
    }
  ],
  "assemblies": [
    {
      "name": "hg19",
      "aliases": [
        "GRCh37"
      ],
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "hg19-refseq",
        "adapter": {
          "type": "TwoBitAdapter",
          "twoBitLocation": {
            "locationType": "UriLocation",
            "uri": "https://hgdownload.soe.ucsc.edu/goldenPath/hg19/bigZips/hg19.2bit"
          },
          "chromSizesLocation": {
            "locationType": "UriLocation",
            "uri": "https://hgdownload.soe.ucsc.edu/goldenPath/hg19/bigZips/hg19.chrom.sizes"
          }
        },
        "displays": [
          {
            "type": "LinearReferenceSequenceDisplay",
            "displayId": "hg19-refseq-LinearReferenceSequenceDisplay"
          },
          {
            "type": "LinearGCContentDisplay",
            "displayId": "hg19-refseq-LinearGCContentDisplay"
          }
        ],
        "metadata": {
          "description": "Feb. 2009 (GRCh37/hg19)",
          "nibPath": "/gbdb/hg19",
          "organism": "Human",
          "defaultPos": "chr7:155592223-155605565",
          "active": 1,
          "orderKey": 60,
          "genome": "Human",
          "scientificName": "Homo sapiens",
          "htmlPath": "/gbdb/hg19/html/description.html",
          "hgNearOk": 1,
          "hgPbOk": 0,
          "sourceName": "GRCh37 Genome Reference Consortium Human Reference 37 (GCA_000001405.1)",
          "taxId": 9606,
          "id": "hg19",
          "name": "hg19",
          "accession": "hg19",
          "commonName": "Human",
          "jbrowseConfig": "https://jbrowse.org/ucsc/hg19/config.json",
          "jbrowseMinimalConfig": "https://jbrowse.org/ucsc/hg19/minimal.json"
        }
      }
    }
  ],
  "tracks": [
    {
      "type": "FeatureTrack",
      "trackId": "genes",
      "name": "NCBI RefSeq Genes",
      "assemblyNames": [
        "hg19"
      ],
      "category": [
        "Genes"
      ],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "uri": "https://s3.amazonaws.com/jbrowse.org/genomes/GRCh38/ncbi_refseq/GCA_000001405.15_GRCh38_full_analysis_set.refseq_annotation.sorted.gff.gz"
      }
    },
    {
      "type": "FeatureTrack",
      "trackId": "hg19-ncbiRefSeq",
      "name": "NCBI RefSeq - RefSeq All",
      "assemblyNames": [
        "hg19"
      ],
      "description": "NCBI RefSeq genes, curated and predicted (NM_*, XM_*, NR_*, XR_*, NP_*, YP_*)",
      "category": [
        "Genes and Gene Predictions"
      ],
      "metadata": {
        "ucsc": {
          "baseColorDefault": "genomicCodons",
          "baseColorUseCds": "given",
          "color": "12,12,120",
          "idXref": "ncbiRefSeqLink mrnaAcc name",
          "longLabel": "NCBI RefSeq genes, curated and predicted (NM_*, XM_*, NR_*, XR_*, NP_*, YP_*)",
          "parent": "refSeqComposite off",
          "priority": "1",
          "shortLabel": "RefSeq All",
          "track": "ncbiRefSeq",
          "html": ""
        }
      },
      "adapter": {
        "type": "Gff3TabixAdapter",
        "gffGzLocation": {
          "locationType": "UriLocation",
          "uri": "https://jbrowse.org/ucsc/hg19/ncbiRefSeq.gff.gz"
        },
        "index": {
          "indexType": "CSI",
          "location": {
            "locationType": "UriLocation",
            "uri": "https://jbrowse.org/ucsc/hg19/ncbiRefSeq.gff.gz.csi"
          }
        }
      },
      "displays": [
        {
          "type": "LinearBasicDisplay",
          "displayId": "hg19-ncbiRefSeq-LinearBasicDisplay"
        },
        {
          "type": "LinearArcDisplay",
          "displayId": "hg19-ncbiRefSeq-LinearArcDisplay"
        }
      ]
    },
    {
      "type": "FeatureTrack",
      "trackId": "hg19-dbSnp153",
